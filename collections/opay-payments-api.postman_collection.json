          "name": "Create Server Payment",
          "request": {
            "name": "Create Server Payment",
            "description": {
              "content": "Server-to-server payment creation. The `payMethod` field selects the\npayment method — `BankCard` (3DS), `BankTransfer`, `BankUSSD`,\n`BankAccount`, `POS`, `OPay`, or `ReferenceCode`. The response\ncontains a `nextAction` describing what the merchant must do next\n(redirect for 3DS, display a virtual transfer account, display a\nUSSD code, etc.). Authenticate with an HMAC-SHA512 signature of the\nJSON body as the bearer token.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "payment",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) The merchant identifier issued by OPay (e.g. 256612345678901).",
                "key": "MerchantId",
                "value": "<string>"
